    "SOURCE":"@AccessControl.authorizationCheck: #NOT_REQUIRED\r\n@EndUserText.label: 'Billing Element Profit Center Text'\r\n@Metadata.ignorePropagatedAnnotations: true\r\ndefine view entity ZI_BILLNGELEM_PROFITCEN_TEXT\r\n  as select from    I_ProjectBillingElement     as BillingElement\r\n  association [0..1] to I_ProfitCenterText           as _ProfitCenterText\r\n                                                        on  $projection.ProfitCenter       = _ProfitCenterText.ProfitCenter\r\n                                                        and $projection.ControllingArea    = _ProfitCenterText.ControllingArea\r\n                                                        and _ProfitCenterText.ValidityStartDate <= $session.system_date                                                        \r\n                                                        and _ProfitCenterText.ValidityEndDate >= $session.system_date                                                        \r\n                                                        and _ProfitCenterText.Language     = $session.system_language\r\n{\r\n      @EndUserText.label:'Project Billing Element UUID'\r\n      key BillingElement.ProjectBillingElementUUID,\r\n      @EndUserText.label:'Profit Center'\r\n      BillingElement._EnterpriseProjectElement.ProfitCenter           as ProfitCenter,\r\n      @EndUserText.label:'Controlling Area'\r\n      BillingElement._EnterpriseProjectElement.ControllingArea        as ControllingArea,  \r\n      \r\n      //Association\r\n      _ProfitCenterText \r\n}\r\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[\n\"I_ENTERPRISEPROJECTELEMENT\",\n\"I_PROJECTBILLINGELEMENT\"\n],\n\"ASSOCIATED\":\n[\n\"I_PROFITCENTERTEXT\"\n],\n\"BASE\":\n[],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
